  "tasks": [
    {
      "id": "E01",
      "zh": {
        "task": "展开一条记忆，再收起并重新展开。",
        "expected": "未展开时不请求详情；每次展开读取当前来源，一次至多一个请求在途。"
      },
      "en": {
        "task": "Expand a memory, collapse it, then reopen it.",
        "expected": "No evidence request before expansion; reopen loads current sources with one request in flight."
      }
    },
    {
      "id": "E02",
      "zh": {
        "task": "延迟来源回执，切换档案后再返回旧回执。",
        "expected": "新档案不显示旧原句或来源说明。"
      },
      "en": {
        "task": "Delay an evidence response, switch profiles, then return the old response.",
        "expected": "The new profile never displays the old quote or explanation."
      }
    },
    {
      "id": "E03",
      "zh": {
        "task": "展开来源后更正或删除这条记忆；保留一个旧请求迟到返回。",
        "expected": "编辑/删除一开始便清详情；旧回执不能恢复。沿用现有保存和删除确认。"
      },
      "en": {
        "task": "Edit or delete an expanded memory, then deliver an old pending response.",
        "expected": "Details clear when editing/deleting starts; stale results cannot restore them. Existing save/delete confirmation remains."
      }
    },
    {
      "id": "E04",
      "zh": {
        "task": "分别展开自述、已确认输入、模拟及无元数据旧记录。",
        "expected": "来源等级有明确区分；计划不写成完成，未知帮助程度不推测；重要性不是可信度。"
      },
      "en": {
        "task": "Open learner-report, confirmed-input, simulation and legacy records.",
        "expected": "Source grades remain distinct; plans do not become accomplishments, unknown support stays unknown, and importance is not credibility."
      }
    },
    {
      "id": "E05",
      "zh": {
        "task": "英文界面查看中英原句；检查来源详情内容。",
        "expected": "标签是英文，原句原样保留；不展示 event_id、lease 或 internal_prompt。"
      },
      "en": {
        "task": "Use the English interface to view Chinese and English quotes.",
        "expected": "Labels are English and quotes remain verbatim; event IDs, leases and internal prompts are not displayed."
      }
    },
    {
      "id": "E06",
      "zh": {
        "task": "来源请求失败或返回与当前记忆不同的快照，再刷新列表并重开；在窄屏查看。",
        "expected": "显示可恢复状态而非旧详情或内部错误；长句换行，编辑删除仍可达。"
      },
      "en": {
        "task": "Fail a request or return a different memory snapshot, then refresh and reopen; inspect a narrow viewport.",
        "expected": "Show a recoverable status, not old details/internal errors; wrap long quotes and keep edit/delete reachable."
      }
    }
  ]
